<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Needed for IDE0005 (unnecessary usings) in builds; docs aren't required on every public member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <Authors>kevbite</Authors>
    <Copyright>Copyright (c) kevbite</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kevbite/Kevsoft.MigrateMongo.Tool</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kevbite/Kevsoft.MigrateMongo.Tool</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mongodb;migrations;migrate-mongo;database;schema</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>false</IsPackable>

    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>

    <!-- Lowest supported MongoDB.Driver; CI overrides this to test the compat matrix. -->
    <MongoDriverVersion Condition="'$(MongoDriverVersion)' == ''">3.9.0</MongoDriverVersion>
  </PropertyGroup>
</Project>
