<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>Turns a console app into a Kevsoft.MigrateMongo migrations runner: `return await MigrateMongoRunner.RunAsync(args);`. Driven by the migrate-mongo tool, or run standalone.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kevsoft.MigrateMongo.MongoDriver\Kevsoft.MigrateMongo.MongoDriver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kevsoft.MigrateMongo.Tests" />
  </ItemGroup>

</Project>
