<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kevsoft.MigrateMongo</RootNamespace>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Configuration, command line and runner protocol contracts shared by the Kevsoft.MigrateMongo tool and runner. Has no MongoDB driver dependency.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kevsoft.MigrateMongo.Tests" />
  </ItemGroup>

</Project>
