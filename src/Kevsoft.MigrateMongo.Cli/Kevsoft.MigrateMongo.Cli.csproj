<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kevsoft.MigrateMongo</RootNamespace>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>The migrate-mongo command line, migrate-mongo.yaml loading and console output shared by the Kevsoft.MigrateMongo tool and runner. Apps that run migrations with Kevsoft.MigrateMongo.Hosting don't need it.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kevsoft.MigrateMongo.Contracts\Kevsoft.MigrateMongo.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kevsoft.MigrateMongo.Tests" />
  </ItemGroup>

</Project>
