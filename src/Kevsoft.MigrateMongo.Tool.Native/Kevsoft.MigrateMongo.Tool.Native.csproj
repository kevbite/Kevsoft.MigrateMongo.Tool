<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The same migrate-mongo tool as Kevsoft.MigrateMongo.Tool, shipped as platform-specific Native AOT packages
    (no .NET runtime needed to start it, so it starts instantly). Installing it needs the .NET 10 SDK or later; older
    SDKs reject RID-specific tool packages, so Kevsoft.MigrateMongo.Tool stays framework-dependent for them.

    `dotnet pack` makes the pointer package, `dotnet pack -r <rid>` (on that OS) makes each Native AOT package, and
    `dotnet pack -r any -p:PublishAot=false` makes the framework-dependent fallback for any other platform.
    All of them must share a version, and the RID packages must be pushed before the pointer package.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>migrate-mongo</AssemblyName>
    <RootNamespace>Kevsoft.MigrateMongo.Tool</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Kevsoft.MigrateMongo.Tool.Native</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>migrate-mongo</ToolCommandName>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <RollForward>LatestMajor</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The pointer package has no content to make a symbol package from. -->
    <IncludeSymbols>false</IncludeSymbols>
    <Description>The migrate-mongo command line tool for Kevsoft.MigrateMongo, compiled to Native AOT for each platform so it starts instantly without a .NET runtime. Needs the .NET 10 SDK or later to install; use Kevsoft.MigrateMongo.Tool for older SDKs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kevsoft.MigrateMongo.Tool\**\*.cs" Exclude="..\Kevsoft.MigrateMongo.Tool\bin\**;..\Kevsoft.MigrateMongo.Tool\obj\**" LinkBase="Tool" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kevsoft.MigrateMongo.Contracts\Kevsoft.MigrateMongo.Contracts.csproj" />
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

</Project>
