<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>Run Kevsoft.MigrateMongo migrations from your own application: `services.AddMongoMigrations(...).FromAssemblyContaining&lt;T&gt;().RunOnStartup()`. Shares the same state collections and lock as the migrate-mongo tool.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kevsoft.MigrateMongo.MongoDriver\Kevsoft.MigrateMongo.MongoDriver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kevsoft.MigrateMongo.Tests" />
  </ItemGroup>

</Project>
