<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      The main package is a pointer to the RID-specific Native AOT packages, which .NET 10+ SDKs install.
      `dotnet pack` makes the main package, `dotnet pack -r <rid>` (on that OS) each Native AOT package, and
      `dotnet pack -r any -p:PublishAot=false` the framework-dependent fallback for RIDs without an AOT build.
      All packages share a version; push the RID packages before the main one.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>migrate-mongo</AssemblyName>
    <RootNamespace>Kevsoft.MigrateMongo.Tool</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Kevsoft.MigrateMongo.Tool</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>migrate-mongo</ToolCommandName>
    <!-- The framework-dependent fallback runs on whatever .NET is installed (10 or any later major); the tool never loads user .NET code (C# migrations run in the user's own project). -->
    <RollForward>LatestMajor</RollForward>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>The migrate-mongo command line tool for Kevsoft.MigrateMongo: create, apply and roll back MongoDB migrations written in C# or JavaScript. C# migrations run in your own project, so any .NET runtime (10+) and supported MongoDB driver version works; JavaScript migrations run in the tool itself, with no .NET SDK needed.</Description>
    <!-- linux-musl-* must be listed, otherwise the RID graph gives Alpine the glibc linux-* build. -->
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <!--
      The RID-specific packages are Native AOT. Native AOT can't cross-compile, so with this set `dotnet pack` without a
      RID makes only the pointer instead of trying to build every RID; `-r any -p:PublishAot=false` makes the fallback.
    -->
    <PublishAot>true</PublishAot>
    <!-- Neither the pointer nor the Native AOT binaries have managed symbols worth a symbol package. -->
    <IncludeSymbols>false</IncludeSymbols>
    <!--
      The .NET 11 SDK makes a no-RID `dotnet pack` also spawn an inner RID-specific (Native AOT) pack for the host,
      which needs a RID-specific build the pointer-only pack never produces (it fails copying migrate-mongo.xml).
      Each RID package is built on its own OS by the `aot` CI job, so the no-RID pack must stay pointer-only. Leaving
      this default (true) for `-r <rid>`/`-r any` packs keeps their RID suffix (e.g. Kevsoft.MigrateMongo.Tool.any).
    -->
    <CreateRidSpecificToolPackages Condition="'$(RuntimeIdentifier)' == ''">false</CreateRidSpecificToolPackages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kevsoft.MigrateMongo.Cli\Kevsoft.MigrateMongo.Cli.csproj" />
    <ProjectReference Include="..\Kevsoft.MigrateMongo.Runner\Kevsoft.MigrateMongo.Runner.csproj" />
    <ProjectReference Include="..\Kevsoft.MigrateMongo.Tunnel\Kevsoft.MigrateMongo.Tunnel.csproj" />
  </ItemGroup>

  <!--
    JavaScript migrations run inside the tool (it spawns itself as the runner), so it carries the driver. The driver
    isn't annotated for trimming; rooting it keeps the BsonDocument paths the scripts use working under Native AOT.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="MongoDB.Bson" />
    <TrimmerRootAssembly Include="MongoDB.Driver" />
  </ItemGroup>

  <!--
    The driver and Jint report trim/AOT warnings for code the scripts never reach (class-map serialization, and Jint's
    CLR interop, which the script host doesn't enable). The driver collapses to one IL2104/IL3053 per assembly, accepted
    here. Jint is marked trimmable, so its RequiresUnreferencedCode calls (IL2026) are reported one by one; they're
    accepted for the Native AOT compile only, as all our assemblies are IsAotCompatible and checked by the analyzers at
    build time. The integration tests run the JavaScript fixtures through the tool to prove the paths we use work.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <Target Name="AcceptThirdPartyTrimWarnings" BeforeTargets="PrepareForILLink">
    <PropertyGroup>
      <NoWarn>$(NoWarn);IL2026</NoWarn>
    </PropertyGroup>
    <ItemGroup>
      <ManagedAssemblyToLink Condition="'%(Filename)' == 'Jint' or '%(Filename)' == 'MongoDB.Bson' or '%(Filename)' == 'MongoDB.Driver'">
        <TrimmerSingleWarn>true</TrimmerSingleWarn>
      </ManagedAssemblyToLink>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Kevsoft.MigrateMongo.Tests" />
  </ItemGroup>

  <!--
    SDK 10.0.4xx+ puts a RID-specific pointer's settings file in tools/any/any/. Keep it under its TFM, where earlier
    10.0 SDK bands put it, so the package layout doesn't depend on which SDK packs it.
  -->
  <Target Name="KeepToolPointerUnderTargetFramework" AfterTargets="PackTool"
          Condition="'$(RuntimeIdentifier)' == '' and '$(ToolPackageRuntimeIdentifiers)' != ''">
    <ItemGroup>
      <TfmSpecificPackageFile Condition="'%(TfmSpecificPackageFile.PackagePath)' == 'tools/any/any/'">
        <PackagePath>tools/$(TargetFramework)/any/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <!--
    .NET 10's Swift crypto library has debug info that points at clang module caches on the machine that built it, so
    dsymutil prints "error: ....pcm: No such file or directory" while making the dSYM. It still succeeds, but the
    Native AOT targets fail the publish on that text. Until a .NET 10 release has .NET 11's fix (dotnet/runtime#124266),
    publishing on macOS (which Native AOT only does for macOS) skips the targets' stripping and runs the same commands
    here instead, without treating their output as errors. Like the link, it only reruns when the link's inputs change.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>

  <Target Name="StripMacOSSymbols" AfterTargets="LinkNative" Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Inputs="$(NativeObject);@(NativeLibrary)" Outputs="$(NativeBinary).dSYM/Contents/Info.plist">
    <Exec Command="dsymutil $(DsymUtilOptions) &quot;$(NativeBinary)&quot; &amp;&amp; strip -no_code_signature_warning -x &quot;$(NativeBinary)&quot;"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>

</Project>
