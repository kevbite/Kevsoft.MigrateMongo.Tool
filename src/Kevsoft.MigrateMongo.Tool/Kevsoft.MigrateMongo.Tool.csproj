<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      The main package is a pointer to the RID-specific Native AOT packages, which .NET 10+ SDKs install.
      `dotnet pack` makes the main package, `dotnet pack -r <rid>` (on that OS) each Native AOT package, and
      `dotnet pack -r any -p:PublishAot=false` the framework-dependent fallback for RIDs without an AOT build.
      All packages share a version; push the RID packages before the main one.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>migrate-mongo</AssemblyName>
    <RootNamespace>Kevsoft.MigrateMongo.Tool</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Kevsoft.MigrateMongo.Tool</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>migrate-mongo</ToolCommandName>
    <!-- The framework-dependent fallback runs on whatever .NET is installed (10 or any later major); the tool never loads user code. -->
    <RollForward>LatestMajor</RollForward>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>The migrate-mongo command line tool for Kevsoft.MigrateMongo: create, apply and roll back MongoDB migrations written in C#. Works with any .NET runtime (10+) and any supported MongoDB driver version because your migrations run in your own project.</Description>
    <!-- linux-musl-* must be listed, otherwise the RID graph gives Alpine the glibc linux-* build. -->
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <!--
      The RID-specific packages are Native AOT. Native AOT can't cross-compile, so with this set `dotnet pack` without a
      RID makes only the pointer instead of trying to build every RID; `-r any -p:PublishAot=false` makes the fallback.
    -->
    <PublishAot>true</PublishAot>
    <!-- Neither the pointer nor the Native AOT binaries have managed symbols worth a symbol package. -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kevsoft.MigrateMongo.Cli\Kevsoft.MigrateMongo.Cli.csproj" />
    <ProjectReference Include="..\Kevsoft.MigrateMongo.Tunnel\Kevsoft.MigrateMongo.Tunnel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kevsoft.MigrateMongo.Tests" />
  </ItemGroup>

  <!--
    SDK 10.0.4xx+ puts a RID-specific pointer's settings file in tools/any/any/. Keep it under its TFM, where earlier
    10.0 SDK bands put it, so the package layout doesn't depend on which SDK packs it.
  -->
  <Target Name="KeepToolPointerUnderTargetFramework" AfterTargets="PackTool"
          Condition="'$(RuntimeIdentifier)' == '' and '$(ToolPackageRuntimeIdentifiers)' != ''">
    <ItemGroup>
      <TfmSpecificPackageFile Condition="'%(TfmSpecificPackageFile.PackagePath)' == 'tools/any/any/'">
        <PackagePath>tools/$(TargetFramework)/any/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
