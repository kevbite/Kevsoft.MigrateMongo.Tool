<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      One package that works with every SDK. Each TFM gets its own tools/<tfm>/any/DotnetToolSettings.xml:
      * net8.0: a framework-dependent tool. .NET 8/9 SDKs pick this (they reject RID-specific tool packages).
      * net10.0: a pointer to the RID-specific Native AOT packages, which .NET 10+ SDKs pick.
      `dotnet pack` makes the main package, `dotnet pack -r <rid>` (on that OS) each Native AOT package, and
      `dotnet pack -r any -p:PublishAot=false` the framework-dependent fallback for RIDs without an AOT build.
      RID builds only target net10.0. All packages share a version; push the RID packages before the main one.
    -->
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == ''">net8.0;net10.0</TargetFrameworks>
    <TargetFramework Condition="'$(RuntimeIdentifier)' != ''">net10.0</TargetFramework>
    <AssemblyName>migrate-mongo</AssemblyName>
    <RootNamespace>Kevsoft.MigrateMongo.Tool</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Kevsoft.MigrateMongo.Tool</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>migrate-mongo</ToolCommandName>
    <!-- Run on whatever .NET is installed (8 or any later major); the tool never loads user code. -->
    <RollForward>LatestMajor</RollForward>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>The migrate-mongo command line tool for Kevsoft.MigrateMongo: create, apply and roll back MongoDB migrations written in C#. Works with any .NET runtime (8+) and any supported MongoDB driver version because your migrations run in your own project.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- linux-musl-* must be listed, otherwise the RID graph gives Alpine the glibc linux-* build. -->
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <!-- RID packages: Native AOT binaries have no managed symbols worth a symbol package. -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kevsoft.MigrateMongo.Contracts\Kevsoft.MigrateMongo.Contracts.csproj" />
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kevsoft.MigrateMongo.Tests" />
  </ItemGroup>

</Project>
