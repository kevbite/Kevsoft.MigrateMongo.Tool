<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The libraries compile against the oldest supported MongoDB.Driver, whose transitive packages have advisories;
         consumers pick their own (newer) driver version. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kevsoft.MigrateMongo\Kevsoft.MigrateMongo.csproj" />
    <ProjectReference Include="..\..\src\Kevsoft.MigrateMongo.Aws\Kevsoft.MigrateMongo.Aws.csproj" />
    <ProjectReference Include="..\..\src\Kevsoft.MigrateMongo.Contracts\Kevsoft.MigrateMongo.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Kevsoft.MigrateMongo.Hosting\Kevsoft.MigrateMongo.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Kevsoft.MigrateMongo.Runner\Kevsoft.MigrateMongo.Runner.csproj" />
    <ProjectReference Include="..\..\src\Kevsoft.MigrateMongo.SourceGenerator\Kevsoft.MigrateMongo.SourceGenerator.csproj" />
    <ProjectReference Include="..\..\src\Kevsoft.MigrateMongo.Tool\Kevsoft.MigrateMongo.Tool.csproj" />
  </ItemGroup>

</Project>
