<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration test fixture. $(MigrateMongoVersion) and $(MigrateMongoDriverVersion) come from the Directory.Build.props the tests generate. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Kevsoft.MigrateMongo.Runner" Version="$(MigrateMongoVersion)" />
    <PackageReference Include="MongoDB.Driver" Version="$(MigrateMongoDriverVersion)" />
  </ItemGroup>

</Project>
